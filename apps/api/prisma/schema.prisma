// See docs/PRODUCT.md for the full data model rationale and business rules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectMemberRole {
  client
  contributor
}

// Single value today — sized so a future provider (e.g. Notion) adds a value
// rather than reshaping this table. See specs/005-github-project-connection.
enum BoardProvider {
  github
}

// How the board's own numeric "Estimate" field converts to a duration when
// used as a fallback for the estimated completion date (specs/008, FR-005b).
enum EstimateUnit {
  days
  hours
}

// The AI's own judgment of a task's complexity, from its title/description —
// one input to the confidence matrix (specs/008, FR-003a).
enum TaskComplexity {
  simple
  complex
}

// Which tier ultimately supplied a task's estimated completion date — the
// other input to the confidence matrix (specs/008, FR-003a).
enum EstimateSource {
  board
  ai
}

// Account-level, independent of ProjectMemberRole above (which is per-project).
// See docs/PRODUCT.md "Open decisions" for the ongoing discussion about
// whether these two should eventually merge.
enum AccountKind {
  developer
  client
}

// A developer can juggle clients in several countries at once — this is a
// per-project preference (not a per-user one) so a French client and a US
// client on two different projects each see dates formatted the way they
// expect. 2026-08-09.
enum ProjectDateFormat {
  mdy
  dmy
  ymd
}

// Same reasoning as ProjectDateFormat above: which language this project's
// content defaults to for its own client, independent of the developer's
// own browsing locale. Mirrors apps/web/i18n/routing.ts's locale set.
enum ProjectLanguage {
  en
  fr
}

enum SourceDocumentKind {
  upload
  notion
}

// A document is stored, read once to check it can be read at all, and then it
// is part of the corpus. Nothing else happens to it: every reference write
// re-reads the originals, so there is no pipeline behind a document any more
// (specs/018).
enum SourceDocumentStatus {
  received
  incorporated
  failed
  removed
}

enum EditorialLength {
  concise
  balanced
  detailed
}

enum EditorialPedagogy {
  direct
  guided
  highly_explanatory
}

enum ClientTechnicalFamiliarity {
  novice
  informed
  technical
}

enum EditorialTone {
  reassuring
  neutral
  direct
  formal
}

// What the section is, not how it reads: the kind decides what the model is
// asked for and what shape the client receives.
enum ClientSectionKind {
  prose
  roadmap
}

enum ClientReleaseReason {
  section_approval
  section_removal
}

enum ClientReleaseStatus {
  queued
  preparing
  validating
  ready
  published
  failed
  superseded
}

enum GenerationOperationType {
  reference_document
  section_composition
  client_derivation
}

enum GenerationOperationStatus {
  queued
  running
  waiting_provider
  retry_scheduled
  succeeded
  needs_attention
  cancelled
  superseded
}

enum GenerationTransport {
  sync
  batch
}

enum GenerationAttemptStatus {
  submitting
  submitted
  polling
  succeeded
  failed
  invalid_output
  abandoned_unknown
  cancelled
}

enum GenerationErrorClass {
  transient
  rate_limited
  credit_exhausted
  model_unavailable
  invalid_request
  input_unprocessable
  invalid_output
  provider_terminal
  policy_denied
  unknown
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  firstName    String      @map("first_name")
  lastName     String      @map("last_name")
  email        String      @unique
  // Nullable: a developer created via GitHub OAuth (specs/009) never has a
  // password. Client accounts (still email/password) always set this.
  passwordHash String?     @map("password_hash")
  accountKind  AccountKind @map("account_kind")
  company      String?
  address      String?
  phone        String?
  image        String?
  bio          String?
  // Free-text, declarative profile field ("here's my GitHub"), unrelated to
  // authentication — do not conflate with githubId below.
  github       String?
  // GitHub's stable numeric account id (as a string), set on first GitHub
  // OAuth login (specs/009-developer-github-oauth). Null for client accounts
  // and for any developer account never authenticated via GitHub.
  githubId     String?     @unique @map("github_id")
  socials      String?
  linkedin     String?
  // Malt is a French freelance-marketplace profile, distinct from a generic
  // personal site — kept as its own field rather than folded into `socials`
  // (a single untyped string can't cleanly hold several distinct profile
  // URLs).
  malt         String?
  website      String?
  roleTitle    String?     @map("role_title")
  status       String?
  // Which language this person reads the product in. Not a setting they fill:
  // the interface already knows it on every request and writes it here, so
  // background work — which has no browser — can still address them in it
  // (specs/018, FR-023).
  locale       String?     @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   ProjectMember[]
  assignedTasks Task[]
  sessions      Session[]

  sourceDocuments          SourceDocument[]  @relation("SourceDocumentAuthor")
  authoredClientSections   ClientSection[]   @relation("ClientSectionAuthor")
  approvedSectionProposals SectionProposal[] @relation("SectionProposalApprover")
  notes                    Note[]            @relation("NoteAuthor")

  @@map("users")
}

// The session id doubles as the bearer secret sent to the client in an
// httpOnly cookie — it's a uuid (cryptographically random), no separate
// token field needed. Deleting the row logs the session out immediately.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String
  status             String?
  progressPercentage Int?               @map("progress_percentage")
  // Not yet surfaced client-side — a Settings field the developer can fill
  // in today so meetings have somewhere to live once the meeting/summary
  // feature (docs/PRODUCT.md "Working notes") is actually built.
  meetingUrl         String?            @map("meeting_url")
  // Not yet consumed by any date-rendering or content-localization logic
  // elsewhere in the app (same "field exists before the feature that reads
  // it" precedent as meetingUrl above) — a developer can set them per
  // project today so the values exist once that wiring happens.
  timezone           String?
  dateFormat         ProjectDateFormat? @map("date_format")
  language           ProjectLanguage?

  // One reference document may be written at a time, guaranteed by the unique
  // constraint rather than by a check the next caller might forget — the same
  // procedure ClientSection.activeProposalId uses.
  activeReferenceDocumentId String? @unique @map("active_reference_document_id") @db.Uuid
  // FR-006: the documents or the notes moved, so the document is out of date.
  // It says so and waits; it never rewrites itself.
  referenceNeedsRewrite     Boolean @default(true) @map("reference_needs_rewrite")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members          ProjectMember[]
  invitations      Invitation[]
  tasks            Task[]
  boardConnection  BoardConnection?
  vulgarizedTasks  VulgarizedTask[]
  taskProgress     TaskProgress[]
  notionConnection NotionConnection?

  sourceDocuments         SourceDocument[]
  clientContentReleases   ClientContentRelease[]
  clientPublication       ProjectClientPublication?
  generationOperations    GenerationOperation[]
  clientSections          ClientSection[]
  clientSectionContents   ClientSectionContent[]
  referenceDocuments      ReferenceDocument[]
  notes                   Note[]
  activeReferenceDocument ReferenceDocument?        @relation("ProjectActiveReferenceDocument", fields: [activeReferenceDocumentId], references: [id], onDelete: SetNull)

  @@map("projects")
}

// Pivot table: this is where project access is granted. See docs/PRODUCT.md
// "Business rules" — role is a security field, and a project must always
// keep at least one admin. Both are enforced in application code, not here.
model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      ProjectMemberRole
  isAdmin   Boolean           @default(false) @map("is_admin")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// Keyed by email, not user_id: the invitee may not have an account yet.
// `token` must stay cryptographically random (see docs/PRODUCT.md).
model Invitation {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  email     String
  role      ProjectMemberRole
  isAdmin   Boolean           @default(false) @map("is_admin")
  token     String            @unique
  status    String
  expiresAt DateTime          @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  assigneeId  String? @map("assignee_id") @db.Uuid
  title       String
  description String?
  status      String?
  duration    Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// One connection per project (see specs/005-github-project-connection). This
// feature only stores the connection itself — no task/issue content is
// fetched or stored here. `encryptedToken` is never returned by the API once
// stored; it is the developer's own GitHub PAT, encrypted at rest.
model BoardConnection {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider BoardProvider

  boardOwnerLogin String @map("board_owner_login")
  boardOwnerType  String @map("board_owner_type")
  boardNumber     Int    @map("board_number")
  boardTitle      String @map("board_title")
  boardUrl        String @map("board_url")

  encryptedToken String @map("encrypted_token")

  // How to interpret the board's numeric "Estimate" field as a duration
  // when there's no "Target date" field to read directly (specs/008,
  // FR-005b). Set at connection-creation time; no edit endpoint exists yet
  // (research.md Decision 5) — reconnect to change it.
  estimateUnit EstimateUnit @default(days) @map("estimate_unit")

  // Set by the background sweep (task-vulgarization.service.ts) when a
  // GitHub call for this connection fails with an auth error (401/403) —
  // the stored token was revoked or is otherwise invalid. Cleared back to
  // false whenever connect() next succeeds for this project (specs/010-
  // github-oauth-board-connection, FR-008, data-model.md).
  needsReconnect Boolean @default(false) @map("needs_reconnect")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("board_connections")
}

model SourceDocument {
  id                  String               @id @default(uuid()) @db.Uuid
  projectId           String               @map("project_id") @db.Uuid
  kind                SourceDocumentKind
  status              SourceDocumentStatus @default(received)
  version             Int                  @default(1)
  title               String
  originalFileName    String?              @map("original_file_name")
  originalMimeType    String?              @map("original_mime_type")
  originalSizeBytes   Int?                 @map("original_size_bytes")
  storedObjectKey     String?              @map("stored_object_key")
  externalUrl         String?              @map("external_url")
  contentSha256       String?              @map("content_sha256") @db.VarChar(64)
  addedByUserId       String               @map("added_by_user_id") @db.Uuid
  failureCode         String?              @map("failure_code") @db.VarChar(128)
  // When the run currently in progress began. Distinct from createdAt: the
  // row showed "processing for 10 hours" after a restart, counting the time
  // already spent before the contributor stopped it.
  processingStartedAt DateTime?            @map("processing_started_at")
  removedAt           DateTime?            @map("removed_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedByUser          User                  @relation("SourceDocumentAuthor", fields: [addedByUserId], references: [id], onDelete: Restrict)
  generationOperations GenerationOperation[]

  @@index([projectId, status, createdAt])
  @@index([projectId, contentSha256])
  @@map("source_documents")
}

// ─── The reference document (specs/018-canonical-source-reading) ──────────────
//
// One written document per project, produced from the canonical source for the
// developer to read. Nothing reads it back: composition still draws only on the
// canonical source. A reading that becomes an input is how a product ends up
// holding two accounts of the same project.

enum ReferenceDocumentStatus {
  writing
  ready
  superseded
  failed
}

// FR-007: documents that hold nothing usable produce a document that says so,
// not an empty one the developer has to interpret.
enum ReferenceDocumentOutcome {
  written
  nothing_usable
}

// One sentence the developer added — an answer to a point, or a correction.
// The two are the same thing: something true that their documents do not say,
// replayed on every write (specs/018, FR-012).
model Note {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  // What the developer wrote. It has to stand on its own: the next write remakes
  // the document, so the paragraph that prompted a correction will not exist.
  content    String
  // A frozen copy of what prompted it — the question, or the paragraph being
  // corrected. Copied, never pointed at, for the same reason.
  context    String?
  authorId   String    @map("author_id") @db.Uuid
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, archivedAt, createdAt])
  @@map("notes")
}

model ReferenceDocument {
  id                    String                    @id @default(uuid()) @db.Uuid
  projectId             String                    @map("project_id") @db.Uuid
  generationOperationId String                    @unique @map("generation_operation_id") @db.Uuid
  status                ReferenceDocumentStatus   @default(writing)
  outcome               ReferenceDocumentOutcome?
  // The language it was written in, kept with the document: a developer who
  // switches interface language keeps reading the one they had until it is
  // rewritten, rather than seeing it half-translated.
  locale                String                    @db.VarChar(8)
  structuredContent     Json?                     @map("structured_content")
  // The points this write could not settle, shown with the document and
  // answered where they appear. Display data: an answered point does not come
  // back because its answer is in the next write's input, not because we
  // recorded that it was answered.
  points                Json?
  // Documents the write could make nothing of — an upload mistake, most
  // likely. Named rather than woven in, so the developer sees which one and
  // decides (FR-017).
  unrelatedDocuments    Json?                     @map("unrelated_documents")
  failureCode           String?                   @map("failure_code") @db.VarChar(128)
  version               Int                       @default(1)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationOperation GenerationOperation @relation("ReferenceDocumentGenerationOperation", fields: [generationOperationId], references: [id], onDelete: Restrict)
  writingForProject   Project?            @relation("ProjectActiveReferenceDocument")
  sectionProposals    SectionProposal[]   @relation("SectionProposalReference")

  @@index([projectId, status, createdAt])
  @@map("reference_documents")
}

// ─── Author-defined client sections (specs/017-documentation-review-journey) ───
//
// A section is a heading its contributor created, not one the product chose.
// The four fixed categories this replaced are gone, along with everything that
// existed to serve them.

enum SectionProposalStatus {
  composing
  pending_review
  approved
  superseded
  failed
}

// FR-011: a composition that matched nothing says so. Without this the caller
// cannot tell "found nothing" from "still composing", and both look like an
// empty block list.
enum SectionProposalOutcome {
  composed
  nothing_matched
}

model ClientSection {
  id                   String                     @id @default(uuid()) @db.Uuid
  projectId            String                     @map("project_id") @db.Uuid
  // Contributor-authored and shown to the client as-is — never a translation
  // key, because the system cannot translate what it did not write
  // (research Decision 7).
  name                 String                     @db.VarChar(120)
  // Prose or a roadmap, decided at creation. A roadmap has no brief and no
  // register — its brief is fixed and a milestone date has no tone — so the
  // five columns below are null on one, rather than holding a default nobody
  // chose that the derivation prompt would then read (specs/020).
  kind                 ClientSectionKind          @default(prose)
  // What composition should look for in the canonical source. The field the
  // whole feature's output quality rests on.
  instructions         String?
  length               EditorialLength?
  pedagogy             EditorialPedagogy?
  technicalFamiliarity ClientTechnicalFamiliarity? @map("technical_familiarity")
  tone                 EditorialTone?
  // Which milestone the project is on. A plain column, not a relation:
  // milestones live in the proposal's JSON, so no foreign key can hold it. It
  // survives a regeneration, because where the project stands has nothing to do
  // with what the documents say, and it is cleared when it names nothing.
  currentMilestoneId   String?                    @map("current_milestone_id") @db.Uuid
  sortOrder            Int                        @map("sort_order")
  // True from creation: a section that has never composed needs to.
  refreshNeeded        Boolean                    @default(true) @map("refresh_needed")
  // Soft delete. A deleted section must stop being readable by the client while
  // the proposals and provenance that fed it stay explicable, so every read path
  // filters on this rather than the row disappearing (research Decision 1).
  archivedAt           DateTime?                  @map("archived_at")
  // FR-013 made structural rather than conventional: at most one non-terminal
  // proposal per section, guaranteed by the unique constraint instead of by a
  // check the next caller might forget.
  activeProposalId     String?                    @unique @map("active_proposal_id") @db.Uuid
  createdByUserId      String                     @map("created_by_user_id") @db.Uuid
  version              Int                        @default(1)
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  project        Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser  User                        @relation("ClientSectionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activeProposal SectionProposal?            @relation("SectionActiveProposal", fields: [activeProposalId], references: [id], onDelete: SetNull)
  proposals      SectionProposal[]           @relation("SectionProposals")
  clientContents ClientSectionContent[]
  releaseEntries ClientContentReleaseEntry[]

  @@index([projectId, archivedAt, sortOrder])
  @@map("client_sections")
}

model SectionProposal {
  id                    String                  @id @default(uuid()) @db.Uuid
  sectionId             String                  @map("section_id") @db.Uuid
  // The reference document this was composed from, so a refresh can tell
  // whether the truth has moved since.
  referenceDocumentId   String                  @map("reference_document_id") @db.Uuid
  // The language it was written in, carried the way the reference document
  // carries its own: a composition queued in French must not run in English
  // because the developer changed tab.
  locale                String                  @default("en") @db.VarChar(8)
  generationOperationId String                  @unique @map("generation_operation_id") @db.Uuid
  status                SectionProposalStatus   @default(composing)
  outcome               SectionProposalOutcome?
  structuredContent     Json?                   @map("structured_content")
  changeSummary         String?                 @map("change_summary")
  failureCode           String?                 @map("failure_code") @db.VarChar(128)
  version               Int                     @default(1)
  approvedAt            DateTime?               @map("approved_at")
  approvedByUserId      String?                 @map("approved_by_user_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  section              ClientSection          @relation("SectionProposals", fields: [sectionId], references: [id], onDelete: Cascade)
  activeForSection     ClientSection?         @relation("SectionActiveProposal")
  referenceDocument    ReferenceDocument      @relation("SectionProposalReference", fields: [referenceDocumentId], references: [id], onDelete: Restrict)
  generationOperation  GenerationOperation    @relation("SectionProposalGenerationOperation", fields: [generationOperationId], references: [id], onDelete: Restrict)
  approvedByUser       User?                  @relation("SectionProposalApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  clientContents       ClientSectionContent[]
  initiatingReleases   ClientContentRelease[] @relation("ReleaseInitiatingProposal")
  derivationOperations GenerationOperation[]  @relation("GenerationSectionProposal")

  @@index([sectionId, status, createdAt])
  @@map("section_proposals")
}

model ClientSectionContent {
  id                    String   @id @default(uuid()) @db.Uuid
  projectId             String   @map("project_id") @db.Uuid
  sectionId             String   @map("section_id") @db.Uuid
  sectionProposalId     String   @map("section_proposal_id") @db.Uuid
  locale                String   @db.VarChar(16)
  outputContractVersion String   @map("output_contract_version") @db.VarChar(64)
  structuredContent     Json     @map("structured_content")
  createdAt             DateTime @default(now()) @map("created_at")

  project              Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section              ClientSection               @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionProposal      SectionProposal             @relation(fields: [sectionProposalId], references: [id], onDelete: Restrict)
  releaseEntries       ClientContentReleaseEntry[]
  generationOperations GenerationOperation[]       @relation("GenerationClientContent")

  @@unique([sectionProposalId, locale, outputContractVersion])
  @@index([projectId, sectionId, locale])
  @@map("client_section_contents")
}

model ClientContentRelease {
  id                   String              @id @default(uuid()) @db.Uuid
  projectId            String              @map("project_id") @db.Uuid
  sequence             Int
  baseReleaseId        String?             @map("base_release_id") @db.Uuid
  reason               ClientReleaseReason
  status               ClientReleaseStatus @default(queued)
  expectedSectionCount Int                 @map("expected_section_count")
  initiatingProposalId String?             @map("initiating_proposal_id") @db.Uuid
  readyAt              DateTime?           @map("ready_at")
  publishedAt          DateTime?           @map("published_at")
  failedAt             DateTime?           @map("failed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  project               Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseRelease           ClientContentRelease?       @relation("ReleaseBase", fields: [baseReleaseId], references: [id], onDelete: Restrict)
  derivedReleases       ClientContentRelease[]      @relation("ReleaseBase")
  initiatingProposal    SectionProposal?            @relation("ReleaseInitiatingProposal", fields: [initiatingProposalId], references: [id], onDelete: Restrict)
  entries               ClientContentReleaseEntry[]
  currentForPublication ProjectClientPublication?   @relation("CurrentClientRelease")
  generationOperations  GenerationOperation[]       @relation("GenerationClientRelease")

  @@unique([projectId, sequence])
  @@index([projectId, status, createdAt])
  @@map("client_content_releases")
}

model ClientContentReleaseEntry {
  releaseId              String @map("release_id") @db.Uuid
  sectionId              String @map("section_id") @db.Uuid
  locale                 String @db.VarChar(16)
  clientSectionContentId String @map("client_section_content_id") @db.Uuid

  release              ClientContentRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  section              ClientSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  clientSectionContent ClientSectionContent @relation(fields: [clientSectionContentId], references: [id], onDelete: Restrict)

  @@id([releaseId, sectionId, locale])
  @@map("client_content_release_entries")
}

model ProjectClientPublication {
  projectId        String   @id @map("project_id") @db.Uuid
  currentReleaseId String?  @unique @map("current_release_id") @db.Uuid
  nextSequence     Int      @default(1) @map("next_sequence")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentRelease ClientContentRelease? @relation("CurrentClientRelease", fields: [currentReleaseId], references: [id], onDelete: SetNull)

  @@map("project_client_publications")
}

model GenerationOperation {
  id                     String                    @id @default(uuid()) @db.Uuid
  projectId              String                    @map("project_id") @db.Uuid
  type                   GenerationOperationType
  deduplicationKey       String                    @unique @map("deduplication_key")
  inputFingerprint       String                    @map("input_fingerprint") @db.VarChar(64)
  sourceDocumentId       String?                   @map("source_document_id") @db.Uuid
  sectionProposalId      String?                   @map("section_proposal_id") @db.Uuid
  clientReleaseId        String?                   @map("client_release_id") @db.Uuid
  clientSectionContentId String?                   @map("client_section_content_id") @db.Uuid
  promptVersion          String                    @map("prompt_version") @db.VarChar(64)
  outputContractVersion  String                    @map("output_contract_version") @db.VarChar(64)
  policySnapshot         Json                      @map("policy_snapshot")
  status                 GenerationOperationStatus @default(queued)
  currentRouteIndex      Int                       @default(0) @map("current_route_index")
  currentAttemptId       String?                   @unique @map("current_attempt_id") @db.Uuid
  runAfter               DateTime                  @default(now()) @map("run_after")
  leaseOwner             String?                   @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt         DateTime?                 @map("lease_expires_at")
  terminalFailureCode    String?                   @map("terminal_failure_code") @db.VarChar(128)
  replacesOperationId    String?                   @map("replaces_operation_id") @db.Uuid
  cancelledAt            DateTime?                 @map("cancelled_at")
  supersededAt           DateTime?                 @map("superseded_at")
  completedAt            DateTime?                 @map("completed_at")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument        SourceDocument?       @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  derivedProposal       SectionProposal?      @relation("GenerationSectionProposal", fields: [sectionProposalId], references: [id], onDelete: Restrict)
  clientRelease         ClientContentRelease? @relation("GenerationClientRelease", fields: [clientReleaseId], references: [id], onDelete: Restrict)
  clientSectionContent  ClientSectionContent? @relation("GenerationClientContent", fields: [clientSectionContentId], references: [id], onDelete: Restrict)
  currentAttempt        GenerationAttempt?    @relation("CurrentGenerationAttempt", fields: [currentAttemptId], references: [id], onDelete: SetNull)
  attempts              GenerationAttempt[]   @relation("GenerationAttempts")
  replacesOperation     GenerationOperation?  @relation("GenerationReplacement", fields: [replacesOperationId], references: [id], onDelete: Restrict)
  replacementOperations GenerationOperation[] @relation("GenerationReplacement")
  sectionProposal       SectionProposal?      @relation("SectionProposalGenerationOperation")
  referenceDocument     ReferenceDocument?    @relation("ReferenceDocumentGenerationOperation")

  @@index([status, runAfter, leaseExpiresAt])
  @@index([projectId, type, createdAt])
  @@map("generation_operations")
}

model GenerationAttempt {
  id                    String                  @id @default(uuid()) @db.Uuid
  operationId           String                  @map("operation_id") @db.Uuid
  ordinal               Int
  routeIndex            Int                     @map("route_index")
  provider              String                  @db.VarChar(64)
  model                 String                  @db.VarChar(128)
  transport             GenerationTransport
  status                GenerationAttemptStatus @default(submitting)
  providerCorrelationId String?                 @map("provider_correlation_id") @db.VarChar(255)
  providerRequestId     String?                 @map("provider_request_id") @db.VarChar(255)
  providerJobId         String?                 @map("provider_job_id") @db.VarChar(255)
  errorClass            GenerationErrorClass?   @map("error_class")
  errorCode             String?                 @map("error_code") @db.VarChar(128)
  errorHttpStatus       Int?                    @map("error_http_status")
  retryable             Boolean?
  protectedDiagnostic   String?                 @map("protected_diagnostic") @db.VarChar(2000)
  inputTokens           Int?                    @map("input_tokens")
  outputTokens          Int?                    @map("output_tokens")
  cacheReadTokens       Int?                    @map("cache_read_tokens")
  cacheWriteTokens      Int?                    @map("cache_write_tokens")
  rawUsage              Json?                   @map("raw_usage")
  estimatedCostMicros   BigInt?                 @map("estimated_cost_micros")
  pricingSnapshot       Json?                   @map("pricing_snapshot")
  pricingVersion        String?                 @map("pricing_version") @db.VarChar(64)
  nextPollAt            DateTime?               @map("next_poll_at")
  submittedAt           DateTime?               @map("submitted_at")
  terminalAt            DateTime?               @map("terminal_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  operation           GenerationOperation  @relation("GenerationAttempts", fields: [operationId], references: [id], onDelete: Cascade)
  currentForOperation GenerationOperation? @relation("CurrentGenerationAttempt")

  @@unique([operationId, ordinal])
  @@index([status, nextPollAt])
  @@map("generation_attempts")
}

// Frozen legacy relation retained for the separately approved post-drain
// schema drop. The active Notion connection is project-scoped and canonical
// document snapshots are stored through SourceDocument.
// A resource's own page id is parsed on demand from `Resource.notionPageUrl`
// (see ResourcesService.createFromNotion), not stored here.
model NotionConnection {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  encryptedToken String @map("encrypted_token")

  // The workspace (or, absent that, integration) name Notion's own
  // GET /v1/users/me response returns at connect time (NotionClient.
  // verifyToken) — surfaced on NotionConnectionCard so a developer sees
  // *what* they're connected to, not just a bare "Connected" (2026-08-08
  // critique, P1). Nullable only because a row created before this field
  // existed would otherwise fail to read; every row created going forward
  // always sets it.
  workspaceName String? @map("workspace_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notion_connections")
}

// One row per (project, GitHub board item, app locale) — see
// specs/007-current-task-vulgarization data-model.md. `original*` and
// `vulgarized*` are only ever written together, atomically, on a successful
// vulgarization call; a failed attempt leaves the row untouched (research.md
// Decision 4) so the next sweep keeps retrying rather than silently freezing
// on stale content. `vulgarized*` stay nullable: no successful vulgarization
// has ever completed yet for this (item, locale) pair.
model VulgarizedTask {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  githubItemId String @map("github_item_id")
  locale       String

  originalTitle       String  @map("original_title")
  originalDescription String? @map("original_description")

  vulgarizedTitle  String? @map("vulgarized_title")
  // 2026-08-09: replaces the old single vulgarizedDescription blob — the
  // client-facing card now shows named sections instead of one paragraph
  // (docs/PRODUCT.md "Working notes"). Each stays independently nullable:
  // the source material may not support a truthful answer for every
  // section, and the vulgarization prompt is instructed to leave a section
  // null rather than invent one (Constitution II, "Never fabricate").
  vulgarizedWhy    String? @map("vulgarized_why")
  vulgarizedImpact String? @map("vulgarized_impact")
  vulgarizedStatus String? @map("vulgarized_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, githubItemId, locale])
  @@map("vulgarized_tasks")
}

// One row per (project, GitHub board item) — locale-independent, unlike
// VulgarizedTask, since none of this data varies by language
// (specs/008-current-task-progress research.md Decision 1).
model TaskProgress {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  githubItemId String @map("github_item_id")

  // Set once, the first time this item is observed as in-progress, and
  // never updated again — the fallback start date when the board provides
  // none (FR-002/FR-006).
  detectedStartedAt DateTime @map("detected_started_at")

  // Resolved fresh every sweep: the board's own "Start date" field when
  // present, else detectedStartedAt (research.md's write-path flow).
  resolvedStartedAt DateTime @map("resolved_started_at")

  // Resolved once per sweep via the three-tier priority order (FR-004).
  // Nullable: no source has ever successfully produced one yet — same
  // "not there yet" semantics as VulgarizedTask.vulgarizedTitle.
  estimatedCompletionAt DateTime?       @map("estimated_completion_at")
  estimateSource        EstimateSource? @map("estimate_source")

  // Always populated whenever the AI call has ever succeeded, independent
  // of whether its estimate is the one actually shown (FR-003a requires the
  // complexity judgment regardless of estimate source). Stored as a
  // duration (not a date, research.md Decision 3) so the AI-tier candidate
  // in estimatedCompletionAt's resolution can be recomputed against a
  // possibly-shifted resolvedStartedAt without re-calling the LLM.
  aiComplexity            TaskComplexity? @map("ai_complexity")
  aiEstimatedDurationDays Int?            @map("ai_estimated_duration_days")

  // The content this row's AI estimate/complexity were computed against —
  // mirrors VulgarizedTask's original* change-detection, but per-item, not
  // per-locale (research.md Decision 6). A failed AI call leaves
  // aiComplexity/the ai-tier estimate untouched and does NOT update these,
  // so the next sweep retries against the same baseline.
  lastEstimatedTitle       String  @map("last_estimated_title")
  lastEstimatedDescription String? @map("last_estimated_description")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, githubItemId])
  @@map("task_progress")
}
