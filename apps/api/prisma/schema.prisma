// See docs/PRODUCT.md for the full data model rationale and business rules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectMemberRole {
  client
  contributor
}

// Single value today — sized so a future provider (e.g. Notion) adds a value
// rather than reshaping this table. See specs/005-github-project-connection.
enum BoardProvider {
  github
}

// How the board's own numeric "Estimate" field converts to a duration when
// used as a fallback for the estimated completion date (specs/008, FR-005b).
enum EstimateUnit {
  days
  hours
}

// The AI's own judgment of a task's complexity, from its title/description —
// one input to the confidence matrix (specs/008, FR-003a).
enum TaskComplexity {
  simple
  complex
}

// Which tier ultimately supplied a task's estimated completion date — the
// other input to the confidence matrix (specs/008, FR-003a).
enum EstimateSource {
  board
  ai
}

// Account-level, independent of ProjectMemberRole above (which is per-project).
// See docs/PRODUCT.md "Open decisions" for the ongoing discussion about
// whether these two should eventually merge.
enum AccountKind {
  developer
  client
}

// specs/011-project-resources.
enum ResourceSource {
  upload
  notion
}

// specs/015: `ready_for_review` and `published` served a per-document
// publication step that no longer exists — validating a category's reference
// content is now the only act that makes anything client-visible (Q3).
enum ResourceStatus {
  pending
  absorbed
  failed
}

// A developer can juggle clients in several countries at once — this is a
// per-project preference (not a per-user one) so a French client and a US
// client on two different projects each see dates formatted the way they
// expect. 2026-08-09.
enum ProjectDateFormat {
  mdy
  dmy
  ymd
}

// Same reasoning as ProjectDateFormat above: which language this project's
// content defaults to for its own client, independent of the developer's
// own browsing locale. Mirrors apps/web/i18n/routing.ts's locale set.
enum ProjectLanguage {
  en
  fr
}

// specs/016-canonical-document-workflow. This state is deliberately a
// database singleton: the migration constrains its id to
// `documentary-transition` and seeds the row before guarded code can run.
enum DocumentaryTransitionMode {
  legacy
  resetting
  canonical
}

enum DocumentaryResetStatus {
  inventoried
  storage_deleting
  storage_failed
  database_purging
  database_failed
  clean
}

enum DocumentaryResetItemStatus {
  pending
  deleted
  already_absent
  failed
}

enum DocumentationCategoryKey {
  overview
  how_it_works
  planning
  other
}

enum SourceDocumentKind {
  upload
  notion
}

enum SourceDocumentStatus {
  received
  extracting
  ready_to_consolidate
  incorporating
  incorporated
  retrying
  failed
  removal_pending
  removal_failed
  removed
}

enum SourceRevisionTrigger {
  document_added
  document_removed
  clarification_answered
  guided_correction
  working_language_changed
}

enum InformationItemKind {
  fact
  decision
  date
  figure
  constraint
  explanation
  open_point
}

enum InformationItemState {
  confirmed
  point_to_clarify
}

enum RevisionChangeKind {
  added
  updated
  confirmed
  superseded
  removed
  provenance_added
  provenance_removed
  translated
  marked_open
  resolved
}

enum ProvenanceRole {
  supports
  conflicts
  supersedes
  confirms
}

enum ContributorAssertionKind {
  guided_correction
  clarification_answer
}

enum ClarificationStatus {
  open
  left_open
  answered
  superseded
}

enum ClarificationResolutionKind {
  answer
  leave_open
}

enum CategoryDraftStatus {
  generating
  pending_review
  correction_generating
  accepted
  discarded
  failed
  superseded
}

enum CategoryDraftTrigger {
  document_added
  document_removed
  clarification
  guided_correction
  working_language_changed
  catch_up
  factual_correction
}

enum CategoryDraftReviewKind {
  accept
  discard
  correction_requested
}

enum EditorialLength {
  concise
  balanced
  detailed
}

enum EditorialPedagogy {
  direct
  guided
  highly_explanatory
}

enum ClientTechnicalFamiliarity {
  novice
  informed
  technical
}

enum EditorialTone {
  reassuring
  neutral
  direct
  formal
}

enum EditorialProposalStatus {
  preview_pending
  preview_ready
  confirmed
  cancelled
  failed
  expired
  saved_without_preview
}

enum ClientReleaseReason {
  category_acceptance
  editorial_profile_change
  category_removal
}

enum ClientReleaseStatus {
  queued
  preparing
  validating
  ready
  published
  failed
  superseded
}

enum GenerationOperationType {
  document_extraction
  source_consolidation
  factual_drafting
  editorial_preview
  client_derivation
  output_validation
}

enum GenerationOperationStatus {
  queued
  running
  waiting_provider
  retry_scheduled
  succeeded
  needs_attention
  cancelled
  superseded
}

enum GenerationTransport {
  sync
  batch
}

enum GenerationAttemptStatus {
  submitting
  submitted
  polling
  succeeded
  failed
  invalid_output
  abandoned_unknown
  cancelled
}

enum GenerationErrorClass {
  transient
  rate_limited
  credit_exhausted
  model_unavailable
  invalid_request
  input_unprocessable
  invalid_output
  provider_terminal
  policy_denied
  unknown
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  firstName    String      @map("first_name")
  lastName     String      @map("last_name")
  email        String      @unique
  // Nullable: a developer created via GitHub OAuth (specs/009) never has a
  // password. Client accounts (still email/password) always set this.
  passwordHash String?     @map("password_hash")
  accountKind  AccountKind @map("account_kind")
  company      String?
  address      String?
  phone        String?
  image        String?
  bio          String?
  // Free-text, declarative profile field ("here's my GitHub"), unrelated to
  // authentication — do not conflate with githubId below.
  github       String?
  // GitHub's stable numeric account id (as a string), set on first GitHub
  // OAuth login (specs/009-developer-github-oauth). Null for client accounts
  // and for any developer account never authenticated via GitHub.
  githubId     String?     @unique @map("github_id")
  socials      String?
  linkedin     String?
  // Malt is a French freelance-marketplace profile, distinct from a generic
  // personal site — kept as its own field rather than folded into `socials`
  // (a single untyped string can't cleanly hold several distinct profile
  // URLs).
  malt         String?
  website      String?
  roleTitle    String?     @map("role_title")
  status       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    ProjectMember[]
  assignedTasks  Task[]
  sessions       Session[]
  addedResources Resource[]

  sourceDocuments            SourceDocument[]                 @relation("SourceDocumentAuthor")
  createdSourceRevisions     SourceRevision[]                 @relation("SourceRevisionCreator")
  contributorAssertions      ContributorAssertion[]           @relation("ContributorAssertionAuthor")
  clarificationResolutions   ClarificationResolution[]        @relation("ClarificationResolver")
  categoryDraftReviews       CategoryDraftReview[]            @relation("CategoryDraftReviewer")
  acceptedCategoryReferences DocumentationCategoryReference[] @relation("CategoryReferenceAcceptor")
  confirmedEditorialProfiles EditorialProfileRevision[]       @relation("EditorialProfileConfirmer")
  editorialProfileProposals  EditorialProfileProposal[]       @relation("EditorialProposalCreator")
  sourceLanguageProposals    SourceLanguageProposal[]         @relation("SourceLanguageProposalCreator")

  @@map("users")
}

// The session id doubles as the bearer secret sent to the client in an
// httpOnly cookie — it's a uuid (cryptographically random), no separate
// token field needed. Deleting the row logs the session out immediately.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String
  status             String?
  progressPercentage Int?               @map("progress_percentage")
  // Not yet surfaced client-side — a Settings field the developer can fill
  // in today so meetings have somewhere to live once the meeting/summary
  // feature (docs/PRODUCT.md "Working notes") is actually built.
  meetingUrl         String?            @map("meeting_url")
  // Not yet consumed by any date-rendering or content-localization logic
  // elsewhere in the app (same "field exists before the feature that reads
  // it" precedent as meetingUrl above) — a developer can set them per
  // project today so the values exist once that wiring happens.
  timezone           String?
  dateFormat         ProjectDateFormat? @map("date_format")
  language           ProjectLanguage?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members            ProjectMember[]
  invitations        Invitation[]
  tasks              Task[]
  boardConnection    BoardConnection?
  vulgarizedTasks    VulgarizedTask[]
  taskProgress       TaskProgress[]
  resources          Resource[]
  notionConnection   NotionConnection?
  categoryReferences CategoryReference[]
  categoryDrafts     CategoryReferenceDraft[]
  categoryContents   CategoryContent[]

  projectSource                   ProjectSource?
  sourceDocuments                 SourceDocument[]
  categoryProjectionStates        CategoryProjectionState[]
  documentationCategoryDrafts     DocumentationCategoryReferenceDraft[]
  documentationCategoryReferences DocumentationCategoryReference[]
  editorialSettings               ProjectEditorialSettings?
  editorialProfileProposals       EditorialProfileProposal[]
  clientCategoryContents          ClientCategoryContent[]
  clientContentReleases           ClientContentRelease[]
  clientPublication               ProjectClientPublication?
  generationOperations            GenerationOperation[]

  @@map("projects")
}

// Pivot table: this is where project access is granted. See docs/PRODUCT.md
// "Business rules" — role is a security field, and a project must always
// keep at least one admin. Both are enforced in application code, not here.
model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      ProjectMemberRole
  isAdmin   Boolean           @default(false) @map("is_admin")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// Keyed by email, not user_id: the invitee may not have an account yet.
// `token` must stay cryptographically random (see docs/PRODUCT.md).
model Invitation {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  email     String
  role      ProjectMemberRole
  isAdmin   Boolean           @default(false) @map("is_admin")
  token     String            @unique
  status    String
  expiresAt DateTime          @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  assigneeId  String? @map("assignee_id") @db.Uuid
  title       String
  description String?
  status      String?
  duration    Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// One connection per project (see specs/005-github-project-connection). This
// feature only stores the connection itself — no task/issue content is
// fetched or stored here. `encryptedToken` is never returned by the API once
// stored; it is the developer's own GitHub PAT, encrypted at rest.
model BoardConnection {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider BoardProvider

  boardOwnerLogin String @map("board_owner_login")
  boardOwnerType  String @map("board_owner_type")
  boardNumber     Int    @map("board_number")
  boardTitle      String @map("board_title")
  boardUrl        String @map("board_url")

  encryptedToken String @map("encrypted_token")

  // How to interpret the board's numeric "Estimate" field as a duration
  // when there's no "Target date" field to read directly (specs/008,
  // FR-005b). Set at connection-creation time; no edit endpoint exists yet
  // (research.md Decision 5) — reconnect to change it.
  estimateUnit EstimateUnit @default(days) @map("estimate_unit")

  // Set by the background sweep (task-vulgarization.service.ts) when a
  // GitHub call for this connection fails with an auth error (401/403) —
  // the stored token was revoked or is otherwise invalid. Cleared back to
  // false whenever connect() next succeeds for this project (specs/010-
  // github-oauth-board-connection, FR-008, data-model.md).
  needsReconnect Boolean @default(false) @map("needs_reconnect")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("board_connections")
}

// Frozen legacy table retained for the separately approved post-drain drop.
// The application runtime no longer reads or writes this model. New
// contributions are represented by SourceDocument and the canonical source
// aggregate below (specs/016-canonical-document-workflow).
model Resource {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  source ResourceSource
  status ResourceStatus @default(pending)

  // Uploaded filename (minus extension) or the Notion page's title — shown
  // on the tile immediately, before/regardless of processing completing.
  title String

  // source: upload only.
  originalFileKey       String? @map("original_file_key")
  originalFileName      String? @map("original_file_name")
  originalFileMimeType  String? @map("original_file_mime_type")
  originalFileSizeBytes Int?    @map("original_file_size_bytes")

  // source: notion only — the "original" link for a resource with no
  // uploaded file (FR-007/FR-008's Notion equivalent).
  notionPageUrl String? @map("notion_page_url")

  // Set only when status: failed (FR-011) — a short, developer-facing note,
  // never shown to a client.
  failureReason String? @map("failure_reason")

  // The Claude Batch API request ID this resource's processing was
  // submitted under (research.md Decision 4), read by
  // ResourceBatchSweepService. Cleared once terminal.
  //
  // specs/014-category-sections research.md Decision 1: the batch now holds
  // a single request producing every section in both locales at once, where
  // 013 submitted three (one per locale, plus category detection).
  anthropicBatchId String? @map("anthropic_batch_id")

  addedByUserId String @map("added_by_user_id") @db.Uuid
  addedByUser   User   @relation(fields: [addedByUserId], references: [id])

  extracts CategoryExtract[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("resources")
}

// specs/015-document-reference-layer data-model.md. What one document
// contributes to one category, in reference register. Never shown to anyone:
// it exists so a category can be rebuilt from the documents that remain when
// one is deleted (research.md Decision 1).
//
// Without it, honouring "delete a document as if it had never been added"
// would mean either re-reading every remaining original from storage on each
// deletion, or asking a model to subtract one document's contribution from
// merged prose — which it cannot do, having no idea which sentence came from
// where.
model CategoryExtract {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  categoryKey ResourceCategoryKey @map("category_key")

  // Written once at ingestion and never rewritten — merging happens
  // downstream, into CategoryReference.
  content String

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([resourceId, categoryKey])
  @@map("category_extracts")
}

// The contributor's own documentation: organised, structured, exhaustive,
// in ordinary professional language. Explicitly NOT vulgarized — the client
// layer below is derived from it.
//
// Single-language on purpose (spec Assumptions): it is a working document
// only its author reads, and CategoryContent already produces both locales.
//
// No status column — existing means live. A category with no validated
// version simply has no row.
model CategoryReference {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  categoryKey ResourceCategoryKey @map("category_key")

  content String

  // Set while the client-facing version is being derived from this content,
  // cleared when it lands. Until then the client keeps reading the previous
  // CategoryContent — which is why derivation writes to its own row rather
  // than rendering this one directly.
  derivationBatchId String? @map("derivation_batch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, categoryKey])
  @@map("category_references")
}

// A regeneration awaiting the contributor's validation, kept apart from the
// live row so a client keeps reading the validated version throughout
// (FR-017) — structural rather than a filter every read has to remember.
//
// The unique constraint does a second job: it serialises two documents
// ingested at once. The second cannot open a competing draft for the same
// category, so its material waits instead of racing.
model CategoryReferenceDraft {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  categoryKey ResourceCategoryKey  @map("category_key")
  status      ReferenceDraftStatus @default(pending_review)

  content String

  // Why this draft exists, surfaced in the review queue so a contributor
  // knows what they are looking at before opening it.
  trigger           DraftTrigger
  triggerResourceId String?      @map("trigger_resource_id") @db.Uuid

  // The review loop (research.md Decision 4). Counting per draft rather than
  // per category is what makes "three attempts at THIS correction" mean
  // something; accepting or discarding deletes the row and resets it.
  attempt         Int     @default(1)
  lastInstruction String? @map("last_instruction")

  // Set while a rebuild is in flight, cleared when it lands. Regeneration
  // rides the same durable batch + sweep path as ingestion rather than a
  // fire-and-forget promise, which would not survive a restart.
  anthropicBatchId String? @map("anthropic_batch_id")

  questions ReferenceQuestion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, categoryKey])
  @@map("category_reference_drafts")
}

enum ReferenceDraftStatus {
  // A rebuild is in flight. The contributor sees the draft marked as such;
  // the client is unaffected either way, since drafts never reach them.
  generating
  pending_review
  awaiting_answers
}

enum DraftTrigger {
  document_added
  document_removed
  regeneration_requested
}

// What a client reads: one continuous plain-language text per category,
// derived from validated reference content and NEVER from a previous version
// of itself (FR-010) — which is what stops detail eroding across successive
// ingestions.
//
// Both locales in one row: they are produced together in a single request,
// which is what guarantees they say the same thing. No review state —
// validating the reference above is the only gate (FR-014), so existing here
// means visible.
model CategoryContent {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  categoryKey ResourceCategoryKey @map("category_key")

  contentEn String @map("content_en")
  contentFr String @map("content_fr")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, categoryKey])
  @@map("category_contents")
}

// specs/015 US5. Raised against a pending draft when two documents contradict
// each other, or when a gap would change what the client is told. Answerable
// or skippable — an unanswered question never blocks validation, it becomes a
// point explicitly marked in the reference content (FR-023).
model ReferenceQuestion {
  id      String                 @id @default(uuid()) @db.Uuid
  draftId String                 @map("draft_id") @db.Uuid
  draft   CategoryReferenceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  question String
  answer   String?
  // Lower is more consequential — FR-022 orders by how much the answer
  // changes what the client will read.
  rank     Int

  createdAt DateTime @default(now()) @map("created_at")

  @@map("reference_questions")
}

// Narrow transition/audit domain for the development reset required by
// specs/016. It intentionally has no relation to Project: the reset is one
// feature-wide boundary and must not cascade with business data.
model DocumentaryTransitionState {
  id String @id @db.VarChar(64)

  mode    DocumentaryTransitionMode @default(legacy)
  version Int                       @default(1)

  activeResetRunId        String?   @map("active_reset_run_id") @db.Uuid
  approvedInventoryDigest String?   @map("approved_inventory_digest") @db.VarChar(64)
  writeFreezeAt           DateTime? @map("write_freeze_at")
  canonicalizedAt         DateTime? @map("canonicalized_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("documentary_transition_states")
}

model DocumentaryResetRun {
  id String @id @default(uuid()) @db.Uuid

  featureKey              String                 @unique @map("feature_key")
  status                  DocumentaryResetStatus @default(inventoried)
  approvedInventoryDigest String                 @map("approved_inventory_digest") @db.VarChar(64)

  storageExpectedCount Int @default(0) @map("storage_expected_count")
  storageDeletedCount  Int @default(0) @map("storage_deleted_count")
  storageFailedCount   Int @default(0) @map("storage_failed_count")
  databaseExpectedRows Int @default(0) @map("database_expected_rows")
  databaseDeletedRows  Int @default(0) @map("database_deleted_rows")

  confirmedAt DateTime  @default(now()) @map("confirmed_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  items DocumentaryResetItem[]

  @@map("documentary_reset_runs")
}

model DocumentaryResetItem {
  id String @id @default(uuid()) @db.Uuid

  resetRunId       String                     @map("reset_run_id") @db.Uuid
  legacyResourceId String                     @map("legacy_resource_id") @db.Uuid
  objectKey        String?                    @map("object_key")
  status           DocumentaryResetItemStatus @default(pending)
  diagnostic       String?                    @db.VarChar(1000)
  attemptCount     Int                        @default(0) @map("attempt_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resetRun DocumentaryResetRun @relation(fields: [resetRunId], references: [id], onDelete: Cascade)

  @@unique([resetRunId, legacyResourceId])
  @@index([resetRunId, status])
  @@map("documentary_reset_items")
}

model ProjectSource {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @unique @map("project_id") @db.Uuid
  workingLanguage   ProjectLanguage @default(en) @map("working_language")
  currentRevisionId String?         @unique @map("current_revision_id") @db.Uuid
  nextSequence      Int             @default(1) @map("next_sequence")
  lockVersion       Int             @default(1) @map("lock_version")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentRevision   SourceRevision?          @relation("CurrentSourceRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions         SourceRevision[]         @relation("SourceRevisions")
  informationItems  InformationItem[]
  assertions        ContributorAssertion[]
  clarifications    Clarification[]
  languageProposals SourceLanguageProposal[]

  @@map("project_sources")
}

model SourceLanguageProposal {
  id                       String          @id @default(uuid()) @db.Uuid
  projectSourceId          String          @map("project_source_id") @db.Uuid
  fromLanguage             ProjectLanguage @map("from_language")
  toLanguage               ProjectLanguage @map("to_language")
  expectedSourceRevisionId String?         @map("expected_source_revision_id") @db.Uuid
  impactedItemCount        Int             @map("impacted_item_count")
  version                  Int             @default(1)
  createdByUserId          String          @map("created_by_user_id") @db.Uuid
  confirmedAt              DateTime?       @map("confirmed_at")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  projectSource          ProjectSource        @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)
  expectedSourceRevision SourceRevision?      @relation("LanguageProposalExpectedRevision", fields: [expectedSourceRevisionId], references: [id], onDelete: Restrict)
  createdBy              User                 @relation("SourceLanguageProposalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  generationOperation    GenerationOperation?

  @@index([projectSourceId, createdAt])
  @@map("source_language_proposals")
}

