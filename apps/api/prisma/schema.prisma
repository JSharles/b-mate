// See docs/PRODUCT.md for the full data model rationale and business rules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectMemberRole {
  client
  contributor
}

// Single value today — sized so a future provider (e.g. Notion) adds a value
// rather than reshaping this table. See specs/005-github-project-connection.
enum BoardProvider {
  github
}

// How the board's own numeric "Estimate" field converts to a duration when
// used as a fallback for the estimated completion date (specs/008, FR-005b).
enum EstimateUnit {
  days
  hours
}

// The AI's own judgment of a task's complexity, from its title/description —
// one input to the confidence matrix (specs/008, FR-003a).
enum TaskComplexity {
  simple
  complex
}

// Which tier ultimately supplied a task's estimated completion date — the
// other input to the confidence matrix (specs/008, FR-003a).
enum EstimateSource {
  board
  ai
}

// Account-level, independent of ProjectMemberRole above (which is per-project).
// See docs/PRODUCT.md "Open decisions" for the ongoing discussion about
// whether these two should eventually merge.
enum AccountKind {
  developer
  client
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  firstName    String      @map("first_name")
  lastName     String      @map("last_name")
  email        String      @unique
  // Nullable: a developer created via GitHub OAuth (specs/009) never has a
  // password. Client accounts (still email/password) always set this.
  passwordHash String?     @map("password_hash")
  accountKind  AccountKind @map("account_kind")
  company      String?
  address      String?
  phone        String?
  image        String?
  bio          String?
  // Free-text, declarative profile field ("here's my GitHub"), unrelated to
  // authentication — do not conflate with githubId below.
  github       String?
  // GitHub's stable numeric account id (as a string), set on first GitHub
  // OAuth login (specs/009-developer-github-oauth). Null for client accounts
  // and for any developer account never authenticated via GitHub.
  githubId     String?     @unique @map("github_id")
  socials      String?
  roleTitle    String?     @map("role_title")
  status       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   ProjectMember[]
  assignedTasks Task[]
  sessions      Session[]

  @@map("users")
}

// The session id doubles as the bearer secret sent to the client in an
// httpOnly cookie — it's a uuid (cryptographically random), no separate
// token field needed. Deleting the row logs the session out immediately.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id                 String  @id @default(uuid()) @db.Uuid
  title              String
  status             String?
  progressPercentage Int?    @map("progress_percentage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members         ProjectMember[]
  invitations     Invitation[]
  tasks           Task[]
  boardConnection BoardConnection?
  vulgarizedTasks VulgarizedTask[]
  taskProgress    TaskProgress[]

  @@map("projects")
}

// Pivot table: this is where project access is granted. See docs/PRODUCT.md
// "Business rules" — role is a security field, and a project must always
// keep at least one admin. Both are enforced in application code, not here.
model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      ProjectMemberRole
  isAdmin   Boolean           @default(false) @map("is_admin")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// Keyed by email, not user_id: the invitee may not have an account yet.
// `token` must stay cryptographically random (see docs/PRODUCT.md).
model Invitation {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  email     String
  role      ProjectMemberRole
  isAdmin   Boolean           @default(false) @map("is_admin")
  token     String            @unique
  status    String
  expiresAt DateTime          @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  assigneeId  String? @map("assignee_id") @db.Uuid
  title       String
  description String?
  status      String?
  duration    Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// One connection per project (see specs/005-github-project-connection). This
// feature only stores the connection itself — no task/issue content is
// fetched or stored here. `encryptedToken` is never returned by the API once
// stored; it is the developer's own GitHub PAT, encrypted at rest.
model BoardConnection {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider BoardProvider

  boardOwnerLogin String @map("board_owner_login")
  boardOwnerType  String @map("board_owner_type")
  boardNumber     Int    @map("board_number")
  boardTitle      String @map("board_title")
  boardUrl        String @map("board_url")

  encryptedToken String @map("encrypted_token")

  // How to interpret the board's numeric "Estimate" field as a duration
  // when there's no "Target date" field to read directly (specs/008,
  // FR-005b). Set at connection-creation time; no edit endpoint exists yet
  // (research.md Decision 5) — reconnect to change it.
  estimateUnit EstimateUnit @default(days) @map("estimate_unit")

  // Set by the background sweep (task-vulgarization.service.ts) when a
  // GitHub call for this connection fails with an auth error (401/403) —
  // the stored token was revoked or is otherwise invalid. Cleared back to
  // false whenever connect() next succeeds for this project (specs/010-
  // github-oauth-board-connection, FR-008, data-model.md).
  needsReconnect Boolean @default(false) @map("needs_reconnect")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("board_connections")
}

// One row per (project, GitHub board item, app locale) — see
// specs/007-current-task-vulgarization data-model.md. `original*` and
// `vulgarized*` are only ever written together, atomically, on a successful
// vulgarization call; a failed attempt leaves the row untouched (research.md
// Decision 4) so the next sweep keeps retrying rather than silently freezing
// on stale content. `vulgarized*` stay nullable: no successful vulgarization
// has ever completed yet for this (item, locale) pair.
model VulgarizedTask {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  githubItemId String @map("github_item_id")
  locale       String

  originalTitle       String  @map("original_title")
  originalDescription String? @map("original_description")

  vulgarizedTitle       String? @map("vulgarized_title")
  vulgarizedDescription String? @map("vulgarized_description")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, githubItemId, locale])
  @@map("vulgarized_tasks")
}

// One row per (project, GitHub board item) — locale-independent, unlike
// VulgarizedTask, since none of this data varies by language
// (specs/008-current-task-progress research.md Decision 1).
model TaskProgress {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  githubItemId String @map("github_item_id")

  // Set once, the first time this item is observed as in-progress, and
  // never updated again — the fallback start date when the board provides
  // none (FR-002/FR-006).
  detectedStartedAt DateTime @map("detected_started_at")

  // Resolved fresh every sweep: the board's own "Start date" field when
  // present, else detectedStartedAt (research.md's write-path flow).
  resolvedStartedAt DateTime @map("resolved_started_at")

  // Resolved once per sweep via the three-tier priority order (FR-004).
  // Nullable: no source has ever successfully produced one yet — same
  // "not there yet" semantics as VulgarizedTask.vulgarizedTitle.
  estimatedCompletionAt DateTime?       @map("estimated_completion_at")
  estimateSource        EstimateSource? @map("estimate_source")

  // Always populated whenever the AI call has ever succeeded, independent
  // of whether its estimate is the one actually shown (FR-003a requires the
  // complexity judgment regardless of estimate source). Stored as a
  // duration (not a date, research.md Decision 3) so the AI-tier candidate
  // in estimatedCompletionAt's resolution can be recomputed against a
  // possibly-shifted resolvedStartedAt without re-calling the LLM.
  aiComplexity            TaskComplexity? @map("ai_complexity")
  aiEstimatedDurationDays Int?            @map("ai_estimated_duration_days")

  // The content this row's AI estimate/complexity were computed against —
  // mirrors VulgarizedTask's original* change-detection, but per-item, not
  // per-locale (research.md Decision 6). A failed AI call leaves
  // aiComplexity/the ai-tier estimate untouched and does NOT update these,
  // so the next sweep retries against the same baseline.
  lastEstimatedTitle       String  @map("last_estimated_title")
  lastEstimatedDescription String? @map("last_estimated_description")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, githubItemId])
  @@map("task_progress")
}
