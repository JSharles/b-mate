// See docs/PRODUCT.md for the full data model rationale and business rules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectMemberRole {
  client
  contributor
}

// Single value today — sized so a future provider (e.g. Notion) adds a value
// rather than reshaping this table. See specs/005-github-project-connection.
enum BoardProvider {
  github
}

// How the board's own numeric "Estimate" field converts to a duration when
// used as a fallback for the estimated completion date (specs/008, FR-005b).
enum EstimateUnit {
  days
  hours
}

// The AI's own judgment of a task's complexity, from its title/description —
// one input to the confidence matrix (specs/008, FR-003a).
enum TaskComplexity {
  simple
  complex
}

// Which tier ultimately supplied a task's estimated completion date — the
// other input to the confidence matrix (specs/008, FR-003a).
enum EstimateSource {
  board
  ai
}

// Account-level, independent of ProjectMemberRole above (which is per-project).
// See docs/PRODUCT.md "Open decisions" for the ongoing discussion about
// whether these two should eventually merge.
enum AccountKind {
  developer
  client
}

// A developer can juggle clients in several countries at once — this is a
// per-project preference (not a per-user one) so a French client and a US
// client on two different projects each see dates formatted the way they
// expect. 2026-08-09.
enum ProjectDateFormat {
  mdy
  dmy
  ymd
}

// Same reasoning as ProjectDateFormat above: which language this project's
// content defaults to for its own client, independent of the developer's
// own browsing locale. Mirrors apps/web/i18n/routing.ts's locale set.
enum ProjectLanguage {
  en
  fr
}

// specs/016-canonical-document-workflow. This state is deliberately a
// database singleton: the migration constrains its id to
// `documentary-transition` and seeds the row before guarded code can run.
enum SourceDocumentKind {
  upload
  notion
}

enum SourceDocumentStatus {
  received
  extracting
  ready_to_consolidate
  incorporating
  incorporated
  retrying
  failed
  removal_pending
  removal_failed
  removed
}

enum SourceRevisionTrigger {
  document_added
  document_removed
  clarification_answered
  guided_correction
}

enum InformationItemKind {
  fact
  decision
  date
  figure
  constraint
  explanation
  open_point
}

enum InformationItemState {
  confirmed
  point_to_clarify
}

enum RevisionChangeKind {
  added
  updated
  confirmed
  superseded
  removed
  provenance_added
  provenance_removed
  marked_open
  resolved
}

enum ProvenanceRole {
  supports
  conflicts
  supersedes
  confirms
}

enum ContributorAssertionKind {
  guided_correction
  clarification_answer
}

enum ClarificationStatus {
  open
  left_open
  answered
  superseded
}

enum ClarificationResolutionKind {
  answer
  leave_open
}

enum EditorialLength {
  concise
  balanced
  detailed
}

enum EditorialPedagogy {
  direct
  guided
  highly_explanatory
}

enum ClientTechnicalFamiliarity {
  novice
  informed
  technical
}

enum EditorialTone {
  reassuring
  neutral
  direct
  formal
}

enum ClientReleaseReason {
  section_approval
  section_removal
}

enum ClientReleaseStatus {
  queued
  preparing
  validating
  ready
  published
  failed
  superseded
}

enum GenerationOperationType {
  document_extraction
  source_consolidation
  reference_document
  section_composition
  client_derivation
}

enum GenerationOperationStatus {
  queued
  running
  waiting_provider
  retry_scheduled
  succeeded
  needs_attention
  cancelled
  superseded
}

enum GenerationTransport {
  sync
  batch
}

enum GenerationAttemptStatus {
  submitting
  submitted
  polling
  succeeded
  failed
  invalid_output
  abandoned_unknown
  cancelled
}

enum GenerationErrorClass {
  transient
  rate_limited
  credit_exhausted
  model_unavailable
  invalid_request
  input_unprocessable
  invalid_output
  provider_terminal
  policy_denied
  unknown
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  firstName    String      @map("first_name")
  lastName     String      @map("last_name")
  email        String      @unique
  // Nullable: a developer created via GitHub OAuth (specs/009) never has a
  // password. Client accounts (still email/password) always set this.
  passwordHash String?     @map("password_hash")
  accountKind  AccountKind @map("account_kind")
  company      String?
  address      String?
  phone        String?
  image        String?
  bio          String?
  // Free-text, declarative profile field ("here's my GitHub"), unrelated to
  // authentication — do not conflate with githubId below.
  github       String?
  // GitHub's stable numeric account id (as a string), set on first GitHub
  // OAuth login (specs/009-developer-github-oauth). Null for client accounts
  // and for any developer account never authenticated via GitHub.
  githubId     String?     @unique @map("github_id")
  socials      String?
  linkedin     String?
  // Malt is a French freelance-marketplace profile, distinct from a generic
  // personal site — kept as its own field rather than folded into `socials`
  // (a single untyped string can't cleanly hold several distinct profile
  // URLs).
  malt         String?
  website      String?
  roleTitle    String?     @map("role_title")
  status       String?
  // Which language this person reads the product in. Not a setting they fill:
  // the interface already knows it on every request and writes it here, so
  // background work — which has no browser — can still address them in it
  // (specs/018, FR-023).
  locale       String?     @db.VarChar(8)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   ProjectMember[]
  assignedTasks Task[]
  sessions      Session[]

  sourceDocuments          SourceDocument[]          @relation("SourceDocumentAuthor")
  createdSourceRevisions   SourceRevision[]          @relation("SourceRevisionCreator")
  contributorAssertions    ContributorAssertion[]    @relation("ContributorAssertionAuthor")
  clarificationResolutions ClarificationResolution[] @relation("ClarificationResolver")
  authoredClientSections   ClientSection[]           @relation("ClientSectionAuthor")
  approvedSectionProposals SectionProposal[]         @relation("SectionProposalApprover")

  @@map("users")
}

// The session id doubles as the bearer secret sent to the client in an
// httpOnly cookie — it's a uuid (cryptographically random), no separate
// token field needed. Deleting the row logs the session out immediately.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Project {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String
  status             String?
  progressPercentage Int?               @map("progress_percentage")
  // Not yet surfaced client-side — a Settings field the developer can fill
  // in today so meetings have somewhere to live once the meeting/summary
  // feature (docs/PRODUCT.md "Working notes") is actually built.
  meetingUrl         String?            @map("meeting_url")
  // Not yet consumed by any date-rendering or content-localization logic
  // elsewhere in the app (same "field exists before the feature that reads
  // it" precedent as meetingUrl above) — a developer can set them per
  // project today so the values exist once that wiring happens.
  timezone           String?
  dateFormat         ProjectDateFormat? @map("date_format")
  language           ProjectLanguage?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members          ProjectMember[]
  invitations      Invitation[]
  tasks            Task[]
  boardConnection  BoardConnection?
  vulgarizedTasks  VulgarizedTask[]
  taskProgress     TaskProgress[]
  notionConnection NotionConnection?

  projectSource         ProjectSource?
  sourceDocuments       SourceDocument[]
  clientContentReleases ClientContentRelease[]
  clientPublication     ProjectClientPublication?
  generationOperations  GenerationOperation[]
  clientSections        ClientSection[]
  clientSectionContents ClientSectionContent[]
  referenceDocuments    ReferenceDocument[]

  @@map("projects")
}

// Pivot table: this is where project access is granted. See docs/PRODUCT.md
// "Business rules" — role is a security field, and a project must always
// keep at least one admin. Both are enforced in application code, not here.
model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  role      ProjectMemberRole
  isAdmin   Boolean           @default(false) @map("is_admin")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// Keyed by email, not user_id: the invitee may not have an account yet.
// `token` must stay cryptographically random (see docs/PRODUCT.md).
model Invitation {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @map("project_id") @db.Uuid
  email     String
  role      ProjectMemberRole
  isAdmin   Boolean           @default(false) @map("is_admin")
  token     String            @unique
  status    String
  expiresAt DateTime          @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model Task {
  id          String  @id @default(uuid()) @db.Uuid
  projectId   String  @map("project_id") @db.Uuid
  assigneeId  String? @map("assignee_id") @db.Uuid
  title       String
  description String?
  status      String?
  duration    Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// One connection per project (see specs/005-github-project-connection). This
// feature only stores the connection itself — no task/issue content is
// fetched or stored here. `encryptedToken` is never returned by the API once
// stored; it is the developer's own GitHub PAT, encrypted at rest.
model BoardConnection {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @unique @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  provider BoardProvider

  boardOwnerLogin String @map("board_owner_login")
  boardOwnerType  String @map("board_owner_type")
  boardNumber     Int    @map("board_number")
  boardTitle      String @map("board_title")
  boardUrl        String @map("board_url")

  encryptedToken String @map("encrypted_token")

  // How to interpret the board's numeric "Estimate" field as a duration
  // when there's no "Target date" field to read directly (specs/008,
  // FR-005b). Set at connection-creation time; no edit endpoint exists yet
  // (research.md Decision 5) — reconnect to change it.
  estimateUnit EstimateUnit @default(days) @map("estimate_unit")

  // Set by the background sweep (task-vulgarization.service.ts) when a
  // GitHub call for this connection fails with an auth error (401/403) —
  // the stored token was revoked or is otherwise invalid. Cleared back to
  // false whenever connect() next succeeds for this project (specs/010-
  // github-oauth-board-connection, FR-008, data-model.md).
  needsReconnect Boolean @default(false) @map("needs_reconnect")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("board_connections")
}

// specs/015-document-reference-layer data-model.md. What one document
// contributes to one category, in reference register. Never shown to anyone:
// it exists so a category can be rebuilt from the documents that remain when
// one is deleted (research.md Decision 1).
//
// Without it, honouring "delete a document as if it had never been added"
// would mean either re-reading every remaining original from storage on each
// deletion, or asking a model to subtract one document's contribution from
// merged prose — which it cannot do, having no idea which sentence came from
// where.
// The contributor's own documentation: organised, structured, exhaustive,
// in ordinary professional language. Explicitly NOT vulgarized — the client
// layer below is derived from it.
//
// Single-language on purpose (spec Assumptions): it is a working document
// only its author reads, and CategoryContent already produces both locales.
//
// No status column — existing means live. A category with no validated
// version simply has no row.
// A regeneration awaiting the contributor's validation, kept apart from the
// live row so a client keeps reading the validated version throughout
// (FR-017) — structural rather than a filter every read has to remember.
//
// The unique constraint does a second job: it serialises two documents
// ingested at once. The second cannot open a competing draft for the same
// category, so its material waits instead of racing.
// What a client reads: one continuous plain-language text per category,
// derived from validated reference content and NEVER from a previous version
// of itself (FR-010) — which is what stops detail eroding across successive
// ingestions.
//
// Both locales in one row: they are produced together in a single request,
// which is what guarantees they say the same thing. No review state —
// validating the reference above is the only gate (FR-014), so existing here
// means visible.
// specs/015 US5. Raised against a pending draft when two documents contradict
// each other, or when a gap would change what the client is told. Answerable
// or skippable — an unanswered question never blocks validation, it becomes a
// point explicitly marked in the reference content (FR-023).
// Narrow transition/audit domain for the development reset required by
// specs/016. It intentionally has no relation to Project: the reset is one
// feature-wide boundary and must not cascade with business data.
model ProjectSource {
  id                        String   @id @default(uuid()) @db.Uuid
  projectId                 String   @unique @map("project_id") @db.Uuid
  currentRevisionId         String?  @unique @map("current_revision_id") @db.Uuid
  nextSequence              Int      @default(1) @map("next_sequence")
  lockVersion               Int      @default(1) @map("lock_version")
  // One reference document may be written at a time, guaranteed by the unique
  // constraint rather than by a check the next caller might forget — the same
  // procedure ClientSection.activeProposalId uses.
  activeReferenceDocumentId String?  @unique @map("active_reference_document_id") @db.Uuid
  // FR-006: the source moved, so the document is out of date. It says so and
  // waits; it never rewrites itself.
  referenceNeedsRewrite     Boolean  @default(true) @map("reference_needs_rewrite")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  project                 Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  currentRevision         SourceRevision?        @relation("CurrentSourceRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  revisions               SourceRevision[]       @relation("SourceRevisions")
  informationItems        InformationItem[]
  assertions              ContributorAssertion[]
  clarifications          Clarification[]
  activeReferenceDocument ReferenceDocument?     @relation("SourceActiveReferenceDocument", fields: [activeReferenceDocumentId], references: [id], onDelete: SetNull)

  @@map("project_sources")
}

model SourceRevision {
  id                     String                @id @default(uuid()) @db.Uuid
  projectSourceId        String                @map("project_source_id") @db.Uuid
  sequence               Int
  parentRevisionId       String?               @map("parent_revision_id") @db.Uuid
  trigger                SourceRevisionTrigger
  triggerDocumentId      String?               @map("trigger_document_id") @db.Uuid
  triggerClarificationId String?               @map("trigger_clarification_id") @db.Uuid
  triggerAssertionId     String?               @map("trigger_assertion_id") @db.Uuid
  createdByUserId        String?               @map("created_by_user_id") @db.Uuid
  summary                String
  createdAt              DateTime              @default(now()) @map("created_at")

  projectSource              ProjectSource          @relation("SourceRevisions", fields: [projectSourceId], references: [id], onDelete: Cascade)
  currentForSource           ProjectSource?         @relation("CurrentSourceRevision")
  parentRevision             SourceRevision?        @relation("SourceRevisionParent", fields: [parentRevisionId], references: [id], onDelete: Restrict)
  childRevisions             SourceRevision[]       @relation("SourceRevisionParent")
  triggerDocument            SourceDocument?        @relation("RevisionTriggerDocument", fields: [triggerDocumentId], references: [id], onDelete: Restrict)
  triggerClarification       Clarification?         @relation("RevisionTriggerClarification", fields: [triggerClarificationId], references: [id], onDelete: Restrict)
  triggerAssertion           ContributorAssertion?  @relation("RevisionTriggerAssertion", fields: [triggerAssertionId], references: [id], onDelete: Restrict)
  createdByUser              User?                  @relation("SourceRevisionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items                      SourceRevisionItem[]
  changes                    SourceRevisionChange[]
  createdInformationItems    InformationItem[]      @relation("InformationItemCreation")
  incorporatedDocuments      SourceDocument[]       @relation("DocumentIncorporatedRevision")
  removedDocuments           SourceDocument[]       @relation("DocumentRemovedRevision")
  detectedClarifications     Clarification[]        @relation("ClarificationDetectedRevision")
  resolvedClarifications     Clarification[]        @relation("ClarificationResolvedRevision")
  appliedAssertions          ContributorAssertion[] @relation("AssertionAppliedRevision")
  generationBaseOperations   GenerationOperation[]  @relation("GenerationBaseRevision")
  generationSourceOperations GenerationOperation[]  @relation("GenerationSourceRevision")
  sectionProposals           SectionProposal[]      @relation("SectionProposalRevision")
  referenceDocuments         ReferenceDocument[]    @relation("ReferenceDocumentRevision")

  @@unique([projectSourceId, sequence])
  @@index([projectSourceId, createdAt])
  @@map("source_revisions")
}

model InformationItem {
  id                  String   @id @default(uuid()) @db.Uuid
  projectSourceId     String   @map("project_source_id") @db.Uuid
  createdInRevisionId String   @map("created_in_revision_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  projectSource        ProjectSource          @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)
  createdInRevision    SourceRevision         @relation("InformationItemCreation", fields: [createdInRevisionId], references: [id], onDelete: Restrict)
  revisionItems        SourceRevisionItem[]
  revisionChanges      SourceRevisionChange[]
  assertions           ContributorAssertion[]
  clarificationItems   ClarificationItem[]
  sectionQuestionItems SectionQuestionItem[]

  @@index([projectSourceId])
  @@map("information_items")
}

model SourceRevisionItem {
  id                     String               @id @default(uuid()) @db.Uuid
  sourceRevisionId       String               @map("source_revision_id") @db.Uuid
  informationItemId      String               @map("information_item_id") @db.Uuid
  previousRevisionItemId String?              @map("previous_revision_item_id") @db.Uuid
  kind                   InformationItemKind
  state                  InformationItemState
  content                String
  sortOrder              Int                  @map("sort_order")

  sourceRevision       SourceRevision         @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)
  informationItem      InformationItem        @relation(fields: [informationItemId], references: [id], onDelete: Restrict)
  previousRevisionItem SourceRevisionItem?    @relation("PreviousRevisionItem", fields: [previousRevisionItemId], references: [id], onDelete: Restrict)
  nextRevisionItems    SourceRevisionItem[]   @relation("PreviousRevisionItem")
  provenanceLinks      ProvenanceLink[]
  beforeChanges        SourceRevisionChange[] @relation("ChangeBeforeItem")
  afterChanges         SourceRevisionChange[] @relation("ChangeAfterItem")

  @@unique([sourceRevisionId, informationItemId])
  @@index([sourceRevisionId, sortOrder])
  @@map("source_revision_items")
}

model SourceRevisionChange {
  id                   String             @id @default(uuid()) @db.Uuid
  sourceRevisionId     String             @map("source_revision_id") @db.Uuid
  informationItemId    String             @map("information_item_id") @db.Uuid
  kind                 RevisionChangeKind
  beforeRevisionItemId String?            @map("before_revision_item_id") @db.Uuid
  afterRevisionItemId  String?            @map("after_revision_item_id") @db.Uuid
  causeDocumentId      String?            @map("cause_document_id") @db.Uuid
  causeAssertionId     String?            @map("cause_assertion_id") @db.Uuid
  explanation          String

  sourceRevision     SourceRevision        @relation(fields: [sourceRevisionId], references: [id], onDelete: Cascade)
  informationItem    InformationItem       @relation(fields: [informationItemId], references: [id], onDelete: Restrict)
  beforeRevisionItem SourceRevisionItem?   @relation("ChangeBeforeItem", fields: [beforeRevisionItemId], references: [id], onDelete: Restrict)
  afterRevisionItem  SourceRevisionItem?   @relation("ChangeAfterItem", fields: [afterRevisionItemId], references: [id], onDelete: Restrict)
  causeDocument      SourceDocument?       @relation("ChangeCauseDocument", fields: [causeDocumentId], references: [id], onDelete: Restrict)
  causeAssertion     ContributorAssertion? @relation("ChangeCauseAssertion", fields: [causeAssertionId], references: [id], onDelete: Restrict)

  @@index([sourceRevisionId])
  @@map("source_revision_changes")
}

model SourceDocument {
  id                       String               @id @default(uuid()) @db.Uuid
  projectId                String               @map("project_id") @db.Uuid
  kind                     SourceDocumentKind
  status                   SourceDocumentStatus @default(received)
  version                  Int                  @default(1)
  title                    String
  originalFileName         String?              @map("original_file_name")
  originalMimeType         String?              @map("original_mime_type")
  originalSizeBytes        Int?                 @map("original_size_bytes")
  storedObjectKey          String?              @map("stored_object_key")
  externalUrl              String?              @map("external_url")
  contentSha256            String?              @map("content_sha256") @db.VarChar(64)
  addedByUserId            String               @map("added_by_user_id") @db.Uuid
  incorporatedInRevisionId String?              @map("incorporated_in_revision_id") @db.Uuid
  removedInRevisionId      String?              @map("removed_in_revision_id") @db.Uuid
  failureCode              String?              @map("failure_code") @db.VarChar(128)
  // When the run currently in progress began. Distinct from createdAt: the
  // row showed "processing for 10 hours" after a restart, counting the time
  // already spent before the contributor stopped it.
  processingStartedAt      DateTime?            @map("processing_started_at")
  removedAt                DateTime?            @map("removed_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  project                Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedByUser            User                   @relation("SourceDocumentAuthor", fields: [addedByUserId], references: [id], onDelete: Restrict)
  incorporatedInRevision SourceRevision?        @relation("DocumentIncorporatedRevision", fields: [incorporatedInRevisionId], references: [id], onDelete: Restrict)
  removedInRevision      SourceRevision?        @relation("DocumentRemovedRevision", fields: [removedInRevisionId], references: [id], onDelete: Restrict)
  triggeredRevisions     SourceRevision[]       @relation("RevisionTriggerDocument")
  changeCauses           SourceRevisionChange[] @relation("ChangeCauseDocument")
  observations           DocumentObservation[]
  generationOperations   GenerationOperation[]

  @@index([projectId, status, createdAt])
  @@index([projectId, contentSha256])
  @@map("source_documents")
}

model DocumentObservation {
  id                String              @id @default(uuid()) @db.Uuid
  sourceDocumentId  String              @map("source_document_id") @db.Uuid
  sequence          Int
  kind              InformationItemKind
  originalExcerpt   String?             @map("original_excerpt")
  normalizedContent String              @map("normalized_content")
  sourceLanguage    String?             @map("source_language") @db.VarChar(16)
  locator           Json?
  exactContentHash  String              @map("exact_content_hash") @db.VarChar(64)
  createdAt         DateTime            @default(now()) @map("created_at")

  sourceDocument        SourceDocument          @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  provenanceLinks       ProvenanceLink[]
  clarificationEvidence ClarificationEvidence[]

  @@unique([sourceDocumentId, sequence])
  @@index([exactContentHash])
  @@map("document_observations")
}

model ContributorAssertion {
  id                      String                   @id @default(uuid()) @db.Uuid
  projectSourceId         String                   @map("project_source_id") @db.Uuid
  authorUserId            String                   @map("author_user_id") @db.Uuid
  kind                    ContributorAssertionKind
  targetInformationItemId String?                  @map("target_information_item_id") @db.Uuid
  content                 String
  reason                  String?
  appliedInRevisionId     String?                  @map("applied_in_revision_id") @db.Uuid
  createdAt               DateTime                 @default(now()) @map("created_at")

  projectSource            ProjectSource             @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)
  authorUser               User                      @relation("ContributorAssertionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  targetInformationItem    InformationItem?          @relation(fields: [targetInformationItemId], references: [id], onDelete: Restrict)
  appliedInRevision        SourceRevision?           @relation("AssertionAppliedRevision", fields: [appliedInRevisionId], references: [id], onDelete: Restrict)
  triggeredRevisions       SourceRevision[]          @relation("RevisionTriggerAssertion")
  changeCauses             SourceRevisionChange[]    @relation("ChangeCauseAssertion")
  provenanceLinks          ProvenanceLink[]
  clarificationEvidence    ClarificationEvidence[]
  answerResolutions        ClarificationResolution[]
  answeredSectionQuestions SectionQuestion[]         @relation("SectionQuestionAnswer")

  @@index([projectSourceId, createdAt])
  @@map("contributor_assertions")
}

model ProvenanceLink {
  id                     String         @id @default(uuid()) @db.Uuid
  sourceRevisionItemId   String         @map("source_revision_item_id") @db.Uuid
  documentObservationId  String?        @map("document_observation_id") @db.Uuid
  contributorAssertionId String?        @map("contributor_assertion_id") @db.Uuid
  role                   ProvenanceRole

  sourceRevisionItem   SourceRevisionItem    @relation(fields: [sourceRevisionItemId], references: [id], onDelete: Cascade)
  documentObservation  DocumentObservation?  @relation(fields: [documentObservationId], references: [id], onDelete: Restrict)
  contributorAssertion ContributorAssertion? @relation(fields: [contributorAssertionId], references: [id], onDelete: Restrict)

  @@index([sourceRevisionItemId, role])
  @@map("provenance_links")
}

model Clarification {
  id                   String              @id @default(uuid()) @db.Uuid
  projectSourceId      String              @map("project_source_id") @db.Uuid
  detectedInRevisionId String              @map("detected_in_revision_id") @db.Uuid
  question             String
  impactRank           Int                 @map("impact_rank")
  impactExplanation    String              @map("impact_explanation")
  status               ClarificationStatus @default(open)
  version              Int                 @default(1)
  resolvedInRevisionId String?             @map("resolved_in_revision_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  projectSource      ProjectSource             @relation(fields: [projectSourceId], references: [id], onDelete: Cascade)
  detectedInRevision SourceRevision            @relation("ClarificationDetectedRevision", fields: [detectedInRevisionId], references: [id], onDelete: Restrict)
  resolvedInRevision SourceRevision?           @relation("ClarificationResolvedRevision", fields: [resolvedInRevisionId], references: [id], onDelete: Restrict)
  triggeredRevisions SourceRevision[]          @relation("RevisionTriggerClarification")
  items              ClarificationItem[]
  evidence           ClarificationEvidence[]
  resolutions        ClarificationResolution[]

  @@index([projectSourceId, status, impactRank, createdAt])
  @@map("clarifications")
}

model ClarificationItem {
  clarificationId   String @map("clarification_id") @db.Uuid
  informationItemId String @map("information_item_id") @db.Uuid

  clarification   Clarification   @relation(fields: [clarificationId], references: [id], onDelete: Cascade)
  informationItem InformationItem @relation(fields: [informationItemId], references: [id], onDelete: Restrict)

  @@id([clarificationId, informationItemId])
  @@map("clarification_items")
}

model ClarificationEvidence {
  id                     String  @id @default(uuid()) @db.Uuid
  clarificationId        String  @map("clarification_id") @db.Uuid
  documentObservationId  String? @map("document_observation_id") @db.Uuid
  contributorAssertionId String? @map("contributor_assertion_id") @db.Uuid

  clarification        Clarification         @relation(fields: [clarificationId], references: [id], onDelete: Cascade)
  documentObservation  DocumentObservation?  @relation(fields: [documentObservationId], references: [id], onDelete: Restrict)
  contributorAssertion ContributorAssertion? @relation(fields: [contributorAssertionId], references: [id], onDelete: Restrict)

  @@index([clarificationId])
  @@map("clarification_evidence")
